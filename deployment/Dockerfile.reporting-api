# syntax=docker/dockerfile:1
# Reporting API image. Build from the REPO ROOT:
#   docker build -f deployment/Dockerfile.reporting-api -t ledgerlab/reporting-api .
FROM node:20-alpine AS builder
RUN corepack enable
WORKDIR /app

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json turbo.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/reporting-api/package.json ./apps/reporting-api/
RUN pnpm install --frozen-lockfile

COPY packages/shared ./packages/shared
COPY apps/reporting-api ./apps/reporting-api
RUN pnpm --filter @ledgerlab/reporting-api build

# Runtime: dist/ is a self-contained bundle, so the image is node + dist only.
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production REPORTING_API_PORT=4002 REPORTING_API_HOST=0.0.0.0
RUN echo '{"type":"module"}' > package.json
COPY --from=builder /app/apps/reporting-api/dist ./dist

USER node
EXPOSE 4002
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.REPORTING_API_PORT||4002)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/index.js"]
